PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://your-ngrok-url.ngrok-free.app/api

# Database Configuration
DATABASE_URL="mysql://username:password@host:port/database_name"

# JWT Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# MoMo Payment Gateway (Test Environment)
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key

# Email Configuration (Brevo HTTP API)
EMAIL_USER=your-email@gmail.com     # Phải là email đã được xác thực (verify) trên Brevo Senders
BREVO_API_KEY=your_brevo_api_key_here  # API Key lấy từ Brevo (SMTP & API -> API Keys)

# Google Gemini AI (dùng cho chatbot / AI features)
GOOGLE_API_KEY=your_google_gemini_api_key

# Python path (dùng cho AI/ML scripts)
PYTHON_PATH=D:\\path\\to\\project\\server\\env\\Scripts\\python.exe