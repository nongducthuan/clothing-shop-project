{
  "name": "nestjs-clothing-shop",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "check:no-any": "node scripts/check-no-any.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "check:nestjs-migration": "node scripts/check-nestjs-migration.cjs",
    "start:prod": "node dist/main.js",
    "test:ci": "jest --runInBand --silent"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "async": "^3.2.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "qs": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/async": "^3.2.26",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs)/)"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "target": "es2020"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    }
  }
}
