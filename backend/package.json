{
    "name": "my-app-server",
    "version": "1.0.0",
    "main": "src/index.ts",
    "scripts": {
        "start": "tsx src/index.ts",
        "dev": "tsx watch src/index.ts",
        "seed": "tsx prisma/seed.ts",
        "seed:admin": "tsx prisma/seedAdmin.ts",
        "postinstall": "prisma generate",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "jest": {
        "testEnvironment": "node",
        "setupFiles": [
            "<rootDir>/src/__tests__/setup.ts"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "typescript",
                            "decorators": true
                        },
                        "target": "es2020"
                    },
                    "module": {
                        "type": "commonjs"
                    }
                }
            ]
        }
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/adapter-mariadb": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "async": "^3.2.6",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.0",
        "jsonwebtoken": "^9.0.2",
        "mariadb": "^3.5.3",
        "multer": "^2.0.2",
        "node-cache": "^5.1.2",
        "node-cron": "^4.6.0",
        "qs": "^6.16.0",
        "socket.io": "^4.8.3",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@swc/core": "^1.16.2",
        "@swc/jest": "^0.2.39",
        "@types/async": "^3.2.26",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "@types/node-cache": "^4.1.3",
        "@types/node-cron": "^3.0.11",
        "@types/qs": "^6.15.1",
        "@types/socket.io": "^3.0.1",
        "@types/supertest": "^7.2.1",
        "jest": "^30.5.1",
        "jest-mock-extended": "^4.0.1",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2"
    }
}
